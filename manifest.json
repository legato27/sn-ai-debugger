{
  "manifest_version": 3,
  "name": "ServiceNow AI Debugger",
  "short_name": "SN AI Debug",
  "version": "0.5.0",
  "description": "Read-only root-cause analysis for ServiceNow AI Agents, agentic workflows and Now Assist skills, using your own logged-in session, with optional stop scripts you review and run yourself.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "ServiceNow AI Debugger",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://*.service-now.com/*",
    "https://*.servicenowservices.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
